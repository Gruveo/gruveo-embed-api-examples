files:
  "/etc/systemd/system/certbot-renew.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Renew Let's Encrypt certificates

      [Service]
      Type=oneshot
      ExecStart=/opt/certbot/bin/certbot renew -q

  "/etc/systemd/system/certbot-renew.timer":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Renew Let's Encrypt certificates twice a day

      [Timer]
      OnCalendar=*-*-* 00,12:00:00
      RandomizedDelaySec=1h
      Persistent=true

      [Install]
      WantedBy=timers.target

container_commands:
  00_install_deps:
    command: "dnf install -y python3"
  10_create_venv:
    command: "python3 -m venv /opt/certbot"
  20_install_certbot:
    command: "/opt/certbot/bin/pip install --upgrade pip certbot certbot-nginx"
  30_link_certbot:
    command: "ln -sf /opt/certbot/bin/certbot /usr/bin/certbot"
  40_enable_renewal:
    command: "systemctl daemon-reload && systemctl enable --now certbot-renew.timer"
